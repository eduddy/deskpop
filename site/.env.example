# Copy to .env.local for local development. All variables are optional:
# without them the site runs in demo mode on the bundled seed dataset.

# Neon Postgres connection string. When set, all content reads come from
# Neon. Initialize/seed the database by visiting /api/setup once.
# DATABASE_URL=postgres://user:password@ep-xxxx.neon.tech/neondb?sslmode=require

# Stripe secret key. When set, /api/checkout creates real Stripe Checkout
# Sessions instead of demo-mode orders.
# STRIPE_SECRET_KEY=sk_test_...
